# Project-local Python environment for development tools (including Hugging Face CLI)
/.venv/

# Generated manuscript output is available through the CI artifact, not Git.
/paper/main.pdf
/paper/build/

# Local agent scaffolding and machine-specific project indexes -- internal
# project-management material, not needed to reproduce the study, kept out
# of the public-facing repo state (still present locally, just untracked)
/AGENTS.md
/CLAUDE.md
/.mex/
/docs/superpowers/

# Local working notes, not part of the study
/extra/

# Data lives on Hugging Face (SolusOps/incremental-instruction-creative-writing),
# not here: judge batches/scores, generation records, human-validation
# records, and the benchmark JSON itself. GitHub carries the code that
# produced/evaluated/analyzed that data instead (see evaluations/,
# analysis/), plus the manuscript and the generation script -- not raw
# judge batches, generated outputs, dashboards, temp files, or tests.
/runs/results/
/runs/test/
/runs/benchmark_data.json
/runs/BENCHMARK.md
/runs/README.md
/runs/monitor_dashboard.py
/runs/test_merge_results.py
/runs/test_run_experiment.py
/runs/hf_upload/

/evaluations/*
!/evaluations/README.md
!/evaluations/judge_config.json
!/evaluations/merge_scores.py
!/evaluations/prepare_native_judge_batches.mjs
!/evaluations/native_judge_worker_instructions.md
!/evaluations/native_judge_long_worker_instructions.md
!/evaluations/native_judge_repair_worker_instructions.md
!/evaluations/human_validation
/evaluations/human_validation/*
!/evaluations/human_validation/evaluate_evidence_first.mjs
!/evaluations/human_validation/validate_pairwise_validation.mjs

/analysis/*
!/analysis/analyze_human_model_agreement.py
